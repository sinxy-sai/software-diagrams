// DeepSeekMoE (DeepSeek-V3 configuration) - architecture figure.
//
// Fixed-position Graphviz source: render with neato -n (--fidelity), which keeps
// every pos="x,-y!" coordinate. Units are points (1 pt = 1/72 in); the canvas is
// 1600 x 1000 pt. y is negated because Graphviz points up while this layout is
// authored top-down. Nodes are declared before the shapes they must paint behind
// (panels, group frames, then cells). The p* nodes are invisible routing points
// that make orthogonal connectors; they are part of the drawing, not entities.
//
// (a) one DeepSeek-V3 transformer layer: RMSNorm -> MLA -> residual add ->
//     RMSNorm -> DeepSeekMoE FFN -> residual add.
// (b) the MoE FFN: 256 routed experts in 8 groups of 32, gate selects top-4
//     groups then top-8 experts; one shared expert is always active.
//
// Design brief (references/figure-design.md):
//   claim     one layer routes a token through 256 grouped experts plus one
//             always-on shared expert, and that is why it stays cheap.
//   audience  readers who know transformers; a zoomable surface.
//   direction paper figure (shelf 2.1): residual rails, one fill per module
//             family, a config note instead of a redundant legend.
//   budget    2 panels, 6 module fills + 3 expert states, 4 type sizes.
//   omitted   backprop, the balancing-loss math, MTP head, and the three
//             dense layers (named in the config note only).
//
// Render: node skills/software-diagrams/scripts/sd.mjs render docs/diagrams/sources/deepseek-moe.dot -o docs/diagrams/rendered/deepseek-moe.svg --fidelity
// Layout was planned by docs/private/deepseek-moe-layout.mjs (scratch, gitignored).
digraph deepseek_moe {
  graph [splines=line, bgcolor="white", pad=0, margin=0, nodesep=0, ranksep=0, fontname="Arial"];
  node [fontname="Arial", fontsize=12, color="#334155", fontcolor="#0F172A", fixedsize=true];
  edge [color="#334155", penwidth=1.7, arrowsize=0.55, fontname="Arial"];

  canvas [shape=box, style=invis, fixedsize=true, width=22.2222, height=13.8889, pos="800,-500!", label=""];
  title [shape=plaintext, pos="800,-40!", label=<<FONT POINT-SIZE="21"><B>DeepSeekMoE: fine-grained experts, shared isolation, grouped routing</B></FONT>>, fontsize=11, fontcolor="#0F172A", margin=0];
  subtitle [shape=plaintext, pos="800,-68!", label=<<FONT POINT-SIZE="11.5">DeepSeek-V3 configuration (671B total / 37B activated) &#183; one of 61 transformer layers</FONT>>, fontsize=11, fontcolor="#64748B", margin=0];
  a_frame [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#E2E8F0", penwidth=1.2, fixedsize=true, width=5.6944, height=11.9444, pos="265,-530!", label="", fontsize=12, fontcolor="#0F172A"];
  a_title [shape=plaintext, pos="265,-128!", label=<<FONT POINT-SIZE="12.5"><B>(a) Transformer layer</B></FONT><FONT POINT-SIZE="11" COLOR="#64748B"> &#183; pre-norm residual block</FONT>>, fontsize=11, fontcolor="#334155", margin=0];
  h_in [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#CBD5E1", penwidth=1.3, fixedsize=true, width=3.4722, height=0.6111, pos="265,-921!", label=<<I>h</I><SUB>t</SUB><SUP>l&#8722;1</SUP>  token hidden state>, fontsize=11.5, fontcolor="#0F172A"];
  norm1 [shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#64748B", penwidth=1.3, fixedsize=true, width=3.0556, height=0.5000, pos="265,-853!", label="RMSNorm", fontsize=11.5, fontcolor="#0F172A"];
  mla [shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#3B82F6", penwidth=1.3, fixedsize=true, width=3.6111, height=1.9444, pos="265,-745!", label=<<B>MLA</B><BR/><FONT POINT-SIZE="10.5">multi-head latent attention</FONT><BR/><FONT POINT-SIZE="9.5" COLOR="#475569">KV cache in 512-d latent</FONT>>, fontsize=12.5, fontcolor="#0F172A"];
  add1 [shape=circle, style="filled", fillcolor="#FFFFFF", color="#334155", penwidth=1.5, fixedsize=true, width=0.3889, height=0.3889, pos="265,-645!", label="+", fontsize=15, fontcolor="#0F172A"];
  norm2 [shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#64748B", penwidth=1.3, fixedsize=true, width=3.0556, height=0.5000, pos="265,-585!", label="RMSNorm", fontsize=11.5, fontcolor="#0F172A"];
  moe [shape=box, style="rounded,filled", fillcolor="#FEF3C7", color="#F59E0B", penwidth=1.8, fixedsize=true, width=3.6111, height=1.8056, pos="265,-470!", label=<<B>DeepSeekMoE FFN</B><BR/>256 routed + 1 shared<BR/><FONT POINT-SIZE="9.5" COLOR="#92400E">detail in (b) &#8594;</FONT>>, fontsize=12.5, fontcolor="#0F172A"];
  add2 [shape=circle, style="filled", fillcolor="#FFFFFF", color="#334155", penwidth=1.5, fixedsize=true, width=0.3889, height=0.3889, pos="265,-370!", label="+", fontsize=15, fontcolor="#0F172A"];
  h_out [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#CBD5E1", penwidth=1.3, fixedsize=true, width=3.4722, height=0.6111, pos="265,-301!", label=<<I>h</I><SUB>t</SUB><SUP>l</SUP>  to next layer>, fontsize=11.5, fontcolor="#0F172A"];
  p0 [shape=point, style=invis, width=0.005, height=0.005, fixedsize=true, pos="104,-921!", label=""];
  p1 [shape=point, style=invis, width=0.005, height=0.005, fixedsize=true, pos="104,-645!", label=""];
  p2 [shape=point, style=invis, width=0.005, height=0.005, fixedsize=true, pos="265,-613!", label=""];
  p3 [shape=point, style=invis, width=0.005, height=0.005, fixedsize=true, pos="78,-613!", label=""];
  p4 [shape=point, style=invis, width=0.005, height=0.005, fixedsize=true, pos="78,-370!", label=""];
  a_eq_box [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#E2E8F0", penwidth=1, fixedsize=true, width=4.4444, height=0.8611, pos="265,-207!", label="", fontsize=12, fontcolor="#0F172A"];
  a_eq [shape=plaintext, pos="265,-207!", label=<<FONT POINT-SIZE="10.5"><I>h</I> &#8592; <I>h</I> + MLA(RMSNorm(<I>h</I>))<BR/><I>h</I> &#8592; <I>h</I> + MoE(RMSNorm(<I>h</I>))</FONT>>, fontsize=11, fontcolor="#64748B", margin=0];
  b_frame [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#E2E8F0", penwidth=1.2, fixedsize=true, width=14.4444, height=11.9444, pos="1040,-530!", label="", fontsize=12, fontcolor="#0F172A"];
  b_title [shape=plaintext, pos="1040,-128!", label=<<FONT POINT-SIZE="12.5"><B>(b) DeepSeekMoE FFN</B></FONT><FONT POINT-SIZE="11" COLOR="#64748B"> &#183; 256 routed experts in 8 groups of 32, plus 1 shared</FONT>>, fontsize=11, fontcolor="#334155", margin=0];
  b_notes [shape=plaintext, pos="810,-231!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0" WIDTH="500"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#475569"><B>Why this design</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#475569">&#8226; <B>Fine-grained experts</B>: 256 small FFNs replace a few large ones,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#475569">&nbsp;&nbsp;&nbsp;raising top-k and sharpening specialization</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#475569">&#8226; <B>Shared expert isolation</B>: an always-on FFN carries common</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#475569">&nbsp;&nbsp;&nbsp;patterns, freeing the routed experts to specialize</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#475569">&#8226; <B>Grouped routing</B>: keep 4 of 8 groups by their top-2 scores,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#475569">&nbsp;&nbsp;&nbsp;then 8 experts inside them &#8212; bounds all-to-all traffic</FONT></TD></TR></TABLE>>, margin=0];
  b_flow [shape=plaintext, pos="840,-345!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0" WIDTH="560"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#64748B"><FONT COLOR="#64748B">one token:</FONT> score 256 experts &#8594; keep 4 groups &#8594; keep 8 experts &#8594; gated sum + shared</FONT></TD></TR></TABLE>>, margin=0];
  legend_h [shape=plaintext, pos="1176,-160!", label=<<FONT POINT-SIZE="11"><B>Legend</B></FONT>>, fontsize=11, fontcolor="#334155", margin=0];
  lg1_sw [shape=box, style="filled", fillcolor="#F97316", color="#C2410C", penwidth=1, fixedsize=true, width=0.1806, height=0.1806, pos="1154.5,-195.5!", label="", fontsize=12, fontcolor="#0F172A"];
  lg1_tx [shape=plaintext, pos="1366,-194.5!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0" WIDTH="380"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#334155"><FONT COLOR="#475569">activated routed expert (top-8)</FONT></FONT></TD></TR></TABLE>>, margin=0];
  lg2_sw [shape=box, style="filled", fillcolor="#E2E8F0", color="#CBD5E1", penwidth=1, fixedsize=true, width=0.1806, height=0.1806, pos="1154.5,-221.5!", label="", fontsize=12, fontcolor="#0F172A"];
  lg2_tx [shape=plaintext, pos="1366,-220.5!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0" WIDTH="380"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#334155"><FONT COLOR="#475569">idle routed expert</FONT></FONT></TD></TR></TABLE>>, margin=0];
  lg3_sw [shape=box, style="filled", fillcolor="#DCFCE7", color="#16A34A", penwidth=1, fixedsize=true, width=0.1806, height=0.1806, pos="1154.5,-247.5!", label="", fontsize=12, fontcolor="#0F172A"];
  lg3_tx [shape=plaintext, pos="1366,-246.5!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0" WIDTH="380"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#334155"><FONT COLOR="#475569">shared expert (always active)</FONT></FONT></TD></TR></TABLE>>, margin=0];
  lg4_sw [shape=box, style="rounded,filled", fillcolor="#FFF7ED", color="#EA580C", penwidth=1.6, fixedsize=true, width=0.2361, height=0.2361, pos="1154.5,-274.5!", label="", fontsize=12, fontcolor="#0F172A"];
  lg4_tx [shape=plaintext, pos="1366,-272.5!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0" WIDTH="380"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#334155"><FONT COLOR="#475569">selected group (top-4)</FONT></FONT></TD></TR></TABLE>>, margin=0];
  cfg_h [shape=plaintext, pos="1186,-316!", label=<<FONT POINT-SIZE="11"><B>Configuration</B></FONT>>, fontsize=11, fontcolor="#334155", margin=0];
  cfg [shape=plaintext, pos="1346,-395!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0" WIDTH="400"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#475569"><B>DeepSeek-V3</B> &#183; 61 layers (58 use this MoE FFN)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#475569">256 routed + 1 shared expert per MoE layer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#475569">top-8 routed experts after top-4 groups</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#475569">gate: sigmoid + aux-loss-free bias <I>b</I><SUB>i</SUB></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5" COLOR="#475569">node-limited routing: &#8804; 4 nodes per token</FONT></TD></TR></TABLE>>, margin=0];
  u_t [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#CBD5E1", penwidth=1.3, fixedsize=true, width=4.1667, height=0.6111, pos="760,-869!", label=<<I>u</I><SUB>t</SUB> = RMSNorm(<I>h</I><SUB>t</SUB>)>, fontsize=11.5, fontcolor="#0F172A"];
  gate [shape=box, style="rounded,filled", fillcolor="#F5F3FF", color="#8B5CF6", penwidth=1.6, fixedsize=true, width=6.6667, height=0.9722, pos="760,-772!", label=<<B>Gate (router)</B>  <FONT POINT-SIZE="10.5">s(i,t) = &#963;(<I>u</I><SUB>t</SUB>&#183;<I>e</I><SUB>i</SUB>) + <I>b</I><SUB>i</SUB></FONT><BR/><FONT POINT-SIZE="9.5" COLOR="#475569">scores all 256 routed experts; group scores then pick the active set</FONT>>, fontsize=12, fontcolor="#0F172A"];
