// Transformer encoder-decoder architecture, redrawn from the reference figure.
// Fixed-position Graphviz source: render with neato -n (nop=1), which keeps every
// pos="x,-y!" coordinate. The invisible p# nodes are routing points for the
// orthogonal connectors; they are part of the drawing, not separate entities.
digraph transformer {
  graph [splines=line, bgcolor="white", pad=0, size="20,20", nodesep=0, ranksep=0, margin=0];
  node [fontname="Arial", fontsize=17, color="#000000", fontcolor="#111111"];
  edge [color="#000000", penwidth=2.4, arrowsize=0.75, fontname="Arial"];

  // Canvas and the two N× containers (declared first so they paint behind).
  canvas [shape=box, style=invis, fixedsize=true, width=8.4583, height=11.375, pos="304.5,-409.5!", label=""];
  enc_box [shape=box, style="rounded,filled", fillcolor="#F3F3F5", color="#000000", penwidth=2.4, fixedsize=true, width=2.638888888888889, height=3.8194444444444446, pos="172,-433.5!", label="", fontsize=18, fontname="Arial", fontcolor="#111111"];
  dec_box [shape=box, style="rounded,filled", fillcolor="#F3F3F5", color="#000000", penwidth=2.4, fixedsize=true, width=2.5972222222222223, height=5.597222222222222, pos="392.5,-369.5!", label="", fontsize=18, fontname="Arial", fontcolor="#111111"];
  // Encoder blocks.
  e_mha [shape=box, style="rounded,filled", fillcolor="#FEE2BA", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.7222222222222222, pos="189,-496!", label="Multi-Head\nAttention", fontsize=18, fontname="Arial", fontcolor="#111111"];
  e_an2 [shape=box, style="filled", fillcolor="#F6F5BE", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.3472222222222222, pos="189,-451.5!", label="Add & Norm", fontsize=17, fontname="Arial", fontcolor="#111111"];
  e_ff [shape=box, style="rounded,filled", fillcolor="#C3E8F8", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.7361111111111112, pos="189,-366.5!", label="Feed\nForward", fontsize=18, fontname="Arial", fontcolor="#111111"];
  e_an1 [shape=box, style="filled", fillcolor="#F6F5BE", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.3472222222222222, pos="189,-322.5!", label="Add & Norm", fontsize=17, fontname="Arial", fontcolor="#111111"];
  e_emb [shape=box, style="rounded,filled", fillcolor="#FDE0E2", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.7222222222222222, pos="189,-665!", label="Input\nEmbedding", fontsize=18, fontname="Arial", fontcolor="#111111"];
  // Decoder blocks.
  d_an3 [shape=box, style="filled", fillcolor="#F6F5BE", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.3472222222222222, pos="378,-430.5!", label="Add & Norm", fontsize=17, fontname="Arial", fontcolor="#111111"];
  d_masked [shape=box, style="rounded,filled", fillcolor="#FEE2BA", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=1.0138888888888888, pos="378,-485.5!", label="Masked\nMulti-Head\nAttention", fontsize=16, fontname="Arial", fontcolor="#111111"];
  d_an2 [shape=box, style="filled", fillcolor="#F6F5BE", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.3472222222222222, pos="378,-302.5!", label="Add & Norm", fontsize=17, fontname="Arial", fontcolor="#111111"];
  d_cross [shape=box, style="rounded,filled", fillcolor="#FEE2BA", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.7222222222222222, pos="378,-347!", label="Multi-Head\nAttention", fontsize=18, fontname="Arial", fontcolor="#111111"];
  d_an1 [shape=box, style="filled", fillcolor="#F6F5BE", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.3472222222222222, pos="378,-192.5!", label="Add & Norm", fontsize=17, fontname="Arial", fontcolor="#111111"];
  d_ff [shape=box, style="rounded,filled", fillcolor="#C3E8F8", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.7222222222222222, pos="378,-238!", label="Feed\nForward", fontsize=18, fontname="Arial", fontcolor="#111111"];
  d_emb [shape=box, style="rounded,filled", fillcolor="#FDE0E2", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.7222222222222222, pos="378,-665!", label="Output\nEmbedding", fontsize=18, fontname="Arial", fontcolor="#111111"];
  // Output head.
  linear [shape=box, style="filled", fillcolor="#DBDEEF", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.2777777777777778, pos="378,-138!", label="Linear", fontsize=18, fontname="Arial", fontcolor="#111111"];
  softmax [shape=box, style="filled", fillcolor="#CAE7D0", color="#000000", penwidth=2.4, fixedsize=true, width=1.7777777777777777, height=0.2777777777777778, pos="378,-89!", label="Softmax", fontsize=18, fontname="Arial", fontcolor="#111111"];
  // Positional encoding and the addition nodes.
  e_plus [shape=circle, style="filled", fillcolor="#FFFFFF", color="#000000", penwidth=2.4, fixedsize=true, width=0.3333333333333333, height=0.3333333333333333, pos="189,-606!", label="+", fontsize=24, fontname="Arial", fontcolor="#111111"];
  e_sine [shape=circle, style="filled", fillcolor="#FFFFFF", color="#000000", penwidth=2.4, fixedsize=true, width=0.5, height=0.5, pos="144,-606!", label="∿", fontsize=44, fontname="Segoe UI Symbol", fontcolor="#111111"];
  d_plus [shape=circle, style="filled", fillcolor="#FFFFFF", color="#000000", penwidth=2.4, fixedsize=true, width=0.3333333333333333, height=0.3333333333333333, pos="378,-606!", label="+", fontsize=24, fontname="Arial", fontcolor="#111111"];
  d_sine [shape=circle, style="filled", fillcolor="#FFFFFF", color="#000000", penwidth=2.4, fixedsize=true, width=0.5, height=0.5, pos="423,-606!", label="∿", fontsize=44, fontname="Segoe UI Symbol", fontcolor="#111111"];
  // Captions.
  t_inputs [shape=plaintext, pos="189,-748!", label="Inputs", fontsize=18, fontname="Arial", fontcolor="#111111", margin=0];
  t_outputs [shape=plaintext, pos="378,-762!", label="Outputs\n(shifted right)", fontsize=18, fontname="Arial", fontcolor="#111111", margin=0];
  t_epe [shape=plaintext, pos="62,-606!", label="Positional\nEncoding", fontsize=17, fontname="Arial", fontcolor="#111111", margin=0];
  t_dpe [shape=plaintext, pos="523,-606!", label="Positional\nEncoding", fontsize=17, fontname="Arial", fontcolor="#111111", margin=0];
  t_enx [shape=plaintext, pos="44,-440!", label="N×", fontsize=19, fontname="Arial", fontcolor="#111111", margin=0];
  t_dnx [shape=plaintext, pos="519,-344!", label="N×", fontsize=19, fontname="Arial", fontcolor="#111111", margin=0];
  t_out [shape=plaintext, pos="378,-26!", label="Output\nProbabilities", fontsize=19, fontname="Arial", fontcolor="#111111", margin=0];
  // Invisible routing points.
  p0 [shape=point, style=invis, width=0.005, height=0.005, fixedsize=true, pos="189,-531!", label=""];
  p1 [shape=point, style=invis, width=0.005, height=0.005, fixedsize=true, pos="157,-531!", label=""];
